{
  "expo": {
    "name": "AnimeDelta",
    "slug": "animedelta",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "animedelta",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05040b",
    "ios": {
      "bundleIdentifier": "app.animedelta.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.animedelta.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#05040b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05040b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}