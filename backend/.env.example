# PostgreSQL. Supabase: Project Settings > Database > Connection string.
# Runtime (pooled, "Transaction pooler", port 6543):
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migrations (direct connection or "Session pooler", port 5432). Used by `prisma migrate`:
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Set true for Supabase / any host requiring TLS
DATABASE_SSL=true

# Backend
PORT=4000
# Reachable base URL of this API (used to build absolute subtitle/media URLs)
API_URL="http://localhost:4000"
# Comma-separated list of tokens allowed to use /api/admin (leave empty to disable admin API)
ADMIN_TOKEN=

# Metadata provider: "mock" (default, offline) or "jikan" (public API, rate limited)
METADATA_PROVIDER=mock
METADATA_API_URL=
METADATA_API_KEY=

# Video provider: "mock" (public test videos) or "library" (media sources you added in the DB)
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# Cron expression for scheduled sync (empty disables)
SYNC_CRON="0 */6 * * *"

# Optional: comma-separated test video URLs for the mock video provider
MOCK_VIDEO_URLS=
